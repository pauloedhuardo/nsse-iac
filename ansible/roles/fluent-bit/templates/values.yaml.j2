# Gerado pela role fluent-bit. Editar a role, nao o cluster.
kind: DaemonSet

# Os control planes sao tainted; sem esta tolerancia os logs deles ficariam de fora.
tolerations:
  - key: node-role.kubernetes.io/control-plane
    operator: Exists
    effect: NoSchedule

env:
  - name: OPENSEARCH_USER
    valueFrom:
      secretKeyRef:
        name: {{ fluent_bit_opensearch_secret }}
        key: user
  - name: OPENSEARCH_PASSWORD
    valueFrom:
      secretKeyRef:
        name: {{ fluent_bit_opensearch_secret }}
        key: password

# O chart monta /var/lib/docker/containers por padrao, que nao existe no CRI-O.
# Basta /var/log: os symlinks de /var/log/containers apontam para /var/log/pods.
daemonSetVolumes:
  - name: varlog
    hostPath:
      path: /var/log
  - name: state
    hostPath:
      path: /var/lib/fluent-bit
      type: DirectoryOrCreate

# /var/log fica somente-leitura: o tail so le dali. O banco de checkpoint
# precisa de escrita e por isso mora num hostPath proprio -- se ficasse sob
# /var/log o Fluent Bit nao sobe ("cannot open database").
daemonSetVolumeMounts:
  - name: varlog
    mountPath: /var/log
    readOnly: true
  - name: state
    mountPath: /var/lib/fluent-bit

config:
  service: |
    [SERVICE]
        Daemon Off
        Flush 1
        Log_Level info
        Parsers_File /fluent-bit/etc/parsers.conf
        Parsers_File /fluent-bit/etc/conf/custom_parsers.conf
        HTTP_Server On
        HTTP_Listen 0.0.0.0
        HTTP_Port 2020
        Health_Check On

  # O CRI-O grava no formato CRI ("<time> stdout F <msg>"), nao no JSON do Docker.
  # O multiline parser cri decodifica esse formato e remonta as linhas partidas (P).
  inputs: |
    [INPUT]
        Name              tail
        Tag               kube.*
        Path              /var/log/containers/*.log
        multiline.parser  cri
        DB                /var/lib/fluent-bit/kube.db
        Mem_Buf_Limit     50MB
        Skip_Long_Lines   On
        Refresh_Interval  10

  filters: |
    [FILTER]
        Name                kubernetes
        Match               kube.*
        Kube_Tag_Prefix     kube.var.log.containers.
        Merge_Log           On
        Merge_Log_Key       log_processed
        Keep_Log            Off
        K8S-Logging.Parser  On
        K8S-Logging.Exclude On
        Labels              On
        Annotations         Off

    [FILTER]
        Name    grep
        Match   kube.*
        Regex   $kubernetes['namespace_name'] ^({{ fluent_bit_namespaces | join('|') }})$

    [FILTER]
        Name    grep
        Match   kube.*
        Exclude $kubernetes['pod_name'] ^({{ fluent_bit_exclude_pods | join('|') }})-

  outputs: |
    [OUTPUT]
        Name                opensearch
        Match               kube.*
        Host                {{ opensearch_endpoint }}
        Port                443
        TLS                 On
        TLS.Verify          On
        HTTP_User           ${OPENSEARCH_USER}
        HTTP_Passwd         ${OPENSEARCH_PASSWORD}
        Logstash_Format     On
        Logstash_Prefix     {{ fluent_bit_index_prefix }}
        Time_Key            @timestamp
        Suppress_Type_Name  On
        Replace_Dots        On
        Retry_Limit         5
